# SIMARS v2 — frontend (Vite)
#
# Konfigurasi utama aplikasi (database, Turnstile, HMAC, webhook) ada di
# api-php/config.php — salin dari api-php/config.example.php, JANGAN di-commit.
#
# File .env frontend ini opsional, hanya berisi flag pengembangan:

# Set "true" untuk mematikan Hot Module Replacement (berguna saat debugging
# bersama PHP backend yang jalan di port 8011).
DISABLE_HMR="false"

