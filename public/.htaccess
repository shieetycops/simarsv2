# SPA fallback untuk React Router (BrowserRouter).
# Tanpa berkas ini, membuka/menyegarkan halaman dalam seperti /surat-masuk
# langsung dari address bar akan dijawab 404 oleh web server.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Jangan pernah menyerahkan /api/* ke index.html — API punya .htaccess sendiri.
    RewriteRule ^api/ - [L]

    # Berkas/direktori nyata (assets hasil build) disajikan apa adanya.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# Jangan tampilkan daftar isi direktori.
Options -Indexes

# Header keamanan untuk halaman aplikasi.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # CSP: hanya izinkan skrip/gaya dari origin sendiri + Turnstile Cloudflare.
    # 'unsafe-inline' pada style dibutuhkan Tailwind/inline style React.
    # img-src memuat https://i.ibb.co.com karena `app_settings.logo_url` di
    # database menunjuk ke sana. Tanpa host itu, logo dirender sebagai gambar
    # rusak (CSP menolak load, bukan 404). Bila logo dipindah ke domain sendiri
    # (disarankan), entri ini boleh dihapus.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ibb.co.com; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
